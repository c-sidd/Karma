# Secrets. The signing key never enters the repository.
.env
.env.*
!.env.example

# Foundry
contracts/out/
contracts/cache/
# Broadcast logs are machine-local and carry per-run transaction data.
contracts/broadcast/
# Local anvil deployments. Real networks (e.g. 11155111.json) stay tracked.
contracts/deployments/31337.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node (from M4)
node_modules/
.next/
out/

# OS
.DS_Store

# Regenerable model outputs. `make model` rebuilds both from source.
# model_report.json is deliberately NOT ignored: it is the evidence.
model/data/
model/artifacts/*.joblib
