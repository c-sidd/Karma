__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
web/.next/
web/out/
web/tsconfig.tsbuildinfo
next-env.d.ts
.env.local

# OS
.DS_Store

# Regenerable model outputs. `make model` rebuilds both from source.
# model_report.json is deliberately NOT ignored: it is the evidence.
model/data/
model/artifacts/*.joblib
