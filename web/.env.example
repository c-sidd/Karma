# Copy to .env.local. Both have working defaults for local development.

# Where the signer service is listening.
NEXT_PUBLIC_SIGNER_URL=http://localhost:8000

# Chain the UI should default to. 31337 = local anvil, 11155111 = Sepolia.
NEXT_PUBLIC_CHAIN_ID=31337

# Optional: an RPC for Sepolia reads. Defaults to the public endpoint, which is
# rate limited but free and needs no account.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
