# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Deployment -------------------------------------------------------------
# A Sepolia key with test ETH. Get some free at https://sepoliafaucet.com
DEPLOYER_PRIVATE_KEY=0x
# Free Sepolia RPC: https://rpc.sepolia.org, or an Alchemy/Infura free-tier URL.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Optional, for source verification. Free key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Model signer -----------------------------------------------------------
# Address of the key the signer service (M3) holds. ScoreOracle accepts only
# signatures from this address until governance registers another.
MODEL_SIGNER_ADDRESS=0x
# The matching private key. Read by the signer service from the environment,
# never written to disk in the repo.
MODEL_SIGNER_PRIVATE_KEY=0x

# --- Optional ---------------------------------------------------------------
# Defaults to the deployer. If set, ownership is offered and must be accepted.
# PROTOCOL_OWNER=0x
# Debt-asset liquidity to seed the pool with, 6dp. Default 1,000,000.
# POOL_SEED_USDC=1000000000000
